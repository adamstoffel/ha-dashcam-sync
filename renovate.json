{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests", ":semanticCommits"],
  "timezone": "UTC",
  "schedule": ["before 6am on monday"],
  "dockerfile": { "fileMatch": ["(^|/)Dockerfile$"] },
  "pip_requirements": { "fileMatch": ["(^|/)requirements.*\\.txt$"] },
  "packageRules": [
    {
      "description": "Keep the app's hashed requirements regenerated from pyproject.toml",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["app/dashcam_sync/requirements.txt"],
      "postUpgradeTasks": {
        "commands": ["pip-compile --generate-hashes --strip-extras --allow-unsafe -o app/dashcam_sync/requirements.txt app/requirements.in"],
        "fileFilters": ["app/dashcam_sync/requirements.txt"]
      }
    },
    {
      "description": "Group GitHub Actions bumps",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
